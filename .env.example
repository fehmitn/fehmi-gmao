# Copiez ce fichier en .env et adaptez les valeurs.
# (.env est ignoré par Git — ne versionnez jamais de secrets ici.)

# --- Base de données -------------------------------------------------------
# URL SQLAlchemy. Par défaut : SQLite dans le dossier du projet.
# DATABASE_URL=sqlite:///./gmao.db
# Pour un PostgreSQL :
# DATABASE_URL=postgresql+psycopg://gmao:gmao@localhost:5432/gmao

# --- Application -----------------------------------------------------------
# Date de référence « aujourd'hui » injectable (tests de rétrodatation).
# Format ISO : AAAA-MM-JJ. Laisser vide pour utiliser la date réelle.
# GMAO_TODAY=2026-06-15

# --- Serveur de développement ---------------------------------------------
# HOST=127.0.0.1
# PORT=8000
# RELOAD=true
